# CAIA environment variables (example — copy to .env.local, never commit real values).
# Real secrets live in Vault (secret/stolution/{env}/*) and are fetched at runtime.

CAIA_ENV=development
NODE_ENV=development

# Control plane
CAIA_EVENT_BUS_URL=redis://localhost:6379/2
CAIA_ARTIFACT_STORE_URL=s3://caia-artifacts-dev
CAIA_LEDGER_DB_URL=postgres://caia:caia@localhost:5432/caia_ledger

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=caia-unset

# LLM providers (per E1 hybrid stack)
OPENROUTER_API_KEY=set-via-vault
ANTHROPIC_API_KEY=set-via-vault

# Vault (for production factory workers)
VAULT_ADDR=https://vault.stolution.com
VAULT_ROLE_ID=set-via-approle
VAULT_SECRET_ID=set-via-approle
